#!/usr/bin/env bash
# santa-run <impl-path> <santa-dir> <out-dir>: ergots' SANTA runner (SANTA runner-integration §3).
#
# Builds the @ergots/* packages and the runner in the checkout this script is part of, then runs the runner over the
# SANTA checkout <santa-dir>. The runner checks its grader and its selection against the checkout's oracle/, selects
# the vector files of runner.json's scope, runs every entry (a file with a budget as a child process under that
# budget) and grades it by vectors/grading.json, and writes <out-dir>/results.json and <out-dir>/actuals/. It reads
# <santa-dir> and writes nothing there.
#
# The checkout it grades is the parent of this script's directory, at its real path; <impl-path>/<repo-name>, SANTA's
# name for the checkout, is the same tree.
#
# The toolchain is the mise.toml beside this script: the script runs itself once more under `mise exec`, so node is
# on PATH for the build and for the run. `mise` on PATH is the one thing it needs.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
[ $# -eq 3 ] || { echo "usage: santa-run <impl-path> <santa-dir> <out-dir>" >&2; exit 2; }
# `mise --cd` and the build move the working directory, so the two directories are made absolute first.
SANTA="$(realpath "$2")"
OUT="$(realpath -m "$3")"
if [ -z "${SANTA_MISE_ACTIVE:-}" ]; then
  mise trust "$here/mise.toml" >/dev/null
  mise --cd "$here" install
  exec env SANTA_MISE_ACTIVE=1 mise --cd "$here" exec -- "$here/santa-run" "$1" "$SANTA" "$OUT"
fi
mkdir -p "$OUT"
root="$(cd "$here/.." && pwd -P)"

# A build step prints nothing when it succeeds and its whole output when it fails.
quiet() {
  local log
  log="$(mktemp)"
  if ! "$@" >"$log" 2>&1; then
    cat "$log" >&2
    rm -f "$log"
    return 1
  fi
  rm -f "$log"
}
cd "$root"
quiet npm install --no-audit --no-fund
quiet npm run build
quiet npm run build -w @ergots/santa-runner

# --max-old-space-size: a bounded file's child runs under the same flags, and V8's own default heap limit could stop
# a row within its budget; a large ceiling leaves the bound to the runner's watchdog (src/harness/bounds.ts).
node --max-old-space-size=65536 "$here/dist/runner.js" run "$here/runner.json" "$SANTA" "$OUT"
