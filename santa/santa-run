#!/usr/bin/env bash
# santa-run <impl-path> <vectors-dir> <out-dir>: ergots' SANTA runner (SANTA runner-integration §3).
#
# Builds the @ergots/* packages and the runner in the checkout this script is part of, then writes one actuals file
# per vector of <vectors-dir> to <out-dir>. The checkout is the parent of this script's directory, at its real path;
# <impl-path>/ergots, the name SANTA gives the checkout, is the same tree.
#
# The toolchain is the mise.toml beside this script: the script runs itself once more under `mise exec`, so node is
# on PATH for the build and for the run. `mise` on PATH is the one thing it needs.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [ -z "${SANTA_MISE_ACTIVE:-}" ]; then
  [ $# -eq 3 ] || { echo "usage: santa-run <impl-path> <vectors-dir> <out-dir>" >&2; exit 2; }
  # `mise --cd` moves the working directory, so the two directories are made absolute first.
  vectors="$(realpath "$2")"
  out="$(realpath -m "$3")"
  mise trust "$here/mise.toml" >/dev/null
  mise --cd "$here" install
  exec env SANTA_MISE_ACTIVE=1 mise --cd "$here" exec -- "$here/santa-run" "$1" "$vectors" "$out"
fi
VECTORS="$2"
OUT="$3"
mkdir -p "$OUT"
root="$(cd "$here/.." && pwd -P)"

# A build step prints nothing when it succeeds and its whole output when it fails.
quiet() {
  local log
  log="$(mktemp)"
  if ! "$@" >"$log" 2>&1; then
    cat "$log" >&2
    rm -f "$log"
    return 1
  fi
  rm -f "$log"
}
cd "$root"
quiet npm install --no-audit --no-fund
quiet npm run build
quiet npm run build -w @ergots/santa-runner

# One node per vector file, stopping at the first that fails; under santa-bound when SANTA_BOUND is set.
# --max-old-space-size: node sizes V8's heap to about half its cgroup's memory, so inside a bounded unit a row within
# the budget would abort at the heap limit and grade `panicked`; a large ceiling leaves the bound to the cgroup.
${SANTA_BOUND:+"$SANTA_BOUND"} bash -c 'for f in "$1"/*.json; do node --max-old-space-size=65536 "$0" "$f" "$2/$(basename "$f")" || exit $?; done' \
  "$here/dist/runner.js" "$VECTORS" "$OUT"
