#!/usr/bin/env bash
# grade [--santa <ref>] [--out <dir>]: grade this checkout against SANTA's vectors.
#
# Fetches SANTA (`mwaddip/santa`, `main` unless --santa names another branch, tag or commit) into a clone of its own
# and checks that commit out over whatever the clone held. The clone is data: its vectors/, its grading rules and its
# oracle/. Then santa-run grades the working tree, uncommitted edits included, and prints one line per slice
# (tier/version/provenance). This script then prints the totals and where the results are:
#   results.json  per slice, the count graded and right in every dimension, and every red entry with its dimension,
#                 what SANTA expects and what ergots answered
#   reds.tsv      one line per red entry: file, entry, dimension, expected, got, note
#   actuals/      ergots' raw answer to every entry, at the vector file's path under vectors/
#
# The clone is $ERGOTS_SANTA_DIR, by default ergots/santa under $XDG_CACHE_HOME (or under .cache in the home
# directory); the results go to --out, by default santa-out beside the clone. A results directory carries the marker
# file .santa-grade: the script clears one it made before a run, and refuses a directory that holds anything else.
# Needs git, mise and jq. The vector files that carry a budget run under the runner's own watchdog, which reads
# /proc: Linux only.
#
# Exits non-zero when the runner could not build or run; santa-run's own message says why.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
root="$(cd "$here/.." && pwd -P)"
usage() { echo "usage: santa/grade [--santa <ref>] [--out <dir>]" >&2; exit 2; }
ref=main out=
while [ $# -gt 0 ]; do
  case $1 in
    --santa) [ $# -ge 2 ] || usage; ref=$2; shift 2 ;;
    --out) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
    *) usage ;;
  esac
done

santa="${ERGOTS_SANTA_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ergots/santa}"
if [ ! -d "$santa/.git" ]; then
  mkdir -p "$(dirname "$santa")"
  git clone --quiet https://github.com/mwaddip/santa.git "$santa"
fi
git -C "$santa" fetch --quiet --tags origin
commit="$(git -C "$santa" rev-parse --verify --quiet "origin/$ref^{commit}" \
  || git -C "$santa" rev-parse --verify --quiet "$ref^{commit}")" \
  || { echo "santa/grade: SANTA has no branch, tag or commit '$ref'" >&2; exit 2; }
git -C "$santa" checkout --quiet --force --detach "$commit"
out="$(realpath -m "${out:-$(dirname "$santa")/santa-out}")"
echo "SANTA $ref @ $(git -C "$santa" rev-parse --short HEAD), grading $root" >&2

# A results directory is one this script made (it holds the marker); what an earlier run left there goes.
if [ -e "$out" ] && [ ! -e "$out/.santa-grade" ] && [ -n "$(ls -A "$out" 2>/dev/null)" ]; then
  echo "santa/grade: $out holds files and is not a results directory of this script; name another --out" >&2
  exit 2
fi
mkdir -p "$out"
: > "$out/.santa-grade"
rm -rf "$out/results.json" "$out/reds.tsv" "$out/actuals" "$out/.children"
"$here/santa-run" - "$santa" "$out"
jq -r '.slices[].red[] | [.file, .entry, .dim, .expected, .got, (.note // "")] | @tsv' "$out/results.json" > "$out/reds.tsv"
echo "red entries: $(jq '.totals.red' "$out/results.json"), of them not implemented: $(jq '.totals.not_implemented' "$out/results.json")"
echo "  $out/results.json"
echo "  $out/reds.tsv"
echo "  $out/actuals/"
