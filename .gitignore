node_modules/
dist/
target/
.DS_Store
*.log

# Library convention: published package strips package-lock.json from the tarball,
# and consumers generate their own lock based on their app. Keeping it untracked
# avoids PR noise on transitive dev-dep updates.
package-lock.json

# Reference checkout (per-developer; not committed)
.reference/

# Per-developer
.vscode/
.idea/

# Local-only session/handoff state (per-developer)
SESSION_CONTEXT.md
HANDOFF_PROMPT.md

# In-workspace git worktrees of upstream / sister repos.
# external/sigma-rust/ is a worktree of ~/projects/sigma-rust/sigma-rust/'s
# `integration/ergots` branch, owned by this project's fixture-gen toolchain.
# Worktrees are pinned to specific branches and shouldn't enter ergots' git.
external/
